from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
import subprocess
import re

app = FastAPI(title="AVR Control")

AVR_INFRA = "/root/avr-infra"
COMPOSE = "/root/avr-infra/docker-compose-weeam.yml"

class CallRequest(BaseModel):
    number: str

def run(cmd, cwd=None):
    result = subprocess.run(
        cmd,
        cwd=cwd,
        capture_output=True,
        text=True,
        timeout=30
    )
    return {
        "code": result.returncode,
        "stdout": result.stdout.strip(),
        "stderr": result.stderr.strip()
    }

def container_status(name):
    result = run([
        "docker", "inspect",
        "-f", "{{.State.Status}}",
        name
    ])
    if result["code"] != 0:
        return "missing"
    return result["stdout"]

@app.get("/api/status")
def status():
    ast = run(["asterisk", "-rx", "core show version"])

    return {
        "asterisk": {
            "online": ast["code"] == 0,
            "version": ast["stdout"]
        },
        "avr_core": container_status("avr-core"),
        "avr_sts_openai": container_status("avr-sts-openai")
    }

@app.post("/api/call")
def call(req: CallRequest):
    number = req.number.strip()

    if not re.fullmatch(r"00[0-9]{8,16}", number):
        raise HTTPException(
            status_code=400,
            detail="Use international digits starting with 00, e.g. 00923041349020"
        )

    dial = f"PJSIP/7{number}@4001"

    asterisk_cmd = (
        f"channel originate {dial} "
        f"extension s@avr-ai-test"
    )

    result = run([
        "asterisk",
        "-rx",
        asterisk_cmd
    ])

    if result["code"] != 0:
        raise HTTPException(
            status_code=500,
            detail=result["stderr"] or result["stdout"]
        )

    return {
        "ok": True,
        "number": number,
        "dial": dial,
        "asterisk_command": asterisk_cmd,
        "result": result["stdout"]
    }


@app.post("/api/restart-ai")
def restart_ai():
    result = run([
        "docker", "compose",
        "-f", COMPOSE,
        "restart",
        "avr-core",
        "avr-sts-openai"
    ], cwd=AVR_INFRA)

    return result

@app.get("/api/logs/{service}")
def logs(service: str):
    allowed = {
        "core": "avr-core",
        "openai": "avr-sts-openai"
    }

    if service not in allowed:
        raise HTTPException(status_code=400, detail="Invalid service")

    result = run([
        "docker", "logs",
        "--tail", "150",
        allowed[service]
    ])

    return {
        "service": service,
        "logs": (result["stdout"] + "\n" + result["stderr"]).strip()
    }

